    <s:String x:Key="mw_terminal_autoscroll">Автопрокручування</s:String>
    <s:String x:Key="mw_terminal_live">LIVE</s:String>
    <s:String x:Key="mw_terminal_busy">ЗАЙНЯТО</s:String>
    <s:String x:Key="mw_uninstall">Видалити</s:String>
    <s:String x:Key="mw_uninstall_tooltip">Повністю видалити Wand / WeMod з цього комп'ютера</s:String>
    <s:String x:Key="dialog_uninstall_title">Видалення Wand / WeMod</s:String>
    <s:String x:Key="dialog_uninstall_confirm">Ви впевнені, що хочете повністю видалити Wand / WeMod з цього комп'ютера?&#x0a;&#x0a;Це завершить запущені процеси, видалить всі файли з AppData, видалить ярлики та очистить реєстр.</s:String>
    <s:String x:Key="mw_open_folder">Відкрити папку встановлення у Провіднику</s:String>
    <s:String x:Key="mw_auto_client_wand">Wand (wand.com)</s:String>
    <s:String x:Key="mw_auto_client_wemod">WeMod (wemod.com)</s:String>
    <s:String x:Key="mw_scam_warning">Це проект з відкритим вихідним кодом. Якщо ви заплатили за нього, вас, скоріш за все, ошукали!</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">Налаштування</s:String>
    <s:String x:Key="settings_language">Мова</s:String>
    <s:String x:Key="settings_preferred_client">Клієнт завантаження</s:String>
    <s:String x:Key="settings_check_updates">Перевіряти оновлення під час запуску</s:String>
    <s:String x:Key="settings_check_prereleases">Також повідомляти про попередні версії</s:String>
    <s:String x:Key="settings_save">Зберегти</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">Доступне оновлення</s:String>
    <s:String x:Key="up_warning">Натисніть Авто-Оновлення, щоб автоматично завантажити та застосувати оновлення з GitHub.</s:String>
    <s:String x:Key="up_current_version">Поточна:</s:String>
    <s:String x:Key="up_latest_version">Остання:</s:String>
    <s:String x:Key="up_release_notes">Примітки до випуску</s:String>
    <s:String x:Key="up_show_more">Показати повний список змін</s:String>
    <s:String x:Key="up_show_less">Показати примітки до випуску</s:String>
    <s:String x:Key="up_loading_changelog">Завантаження...</s:String>
    <s:String x:Key="up_changelog_failed">Не вдалося завантажити повний список змін.</s:String>
