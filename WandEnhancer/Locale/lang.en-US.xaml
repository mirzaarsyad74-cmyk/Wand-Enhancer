<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">English</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">Folder path</s:String>
    <s:String x:Key="mw_folder_not_found">Folder not found</s:String>
    <s:String x:Key="mw_patch">Enhance</s:String>
    <s:String x:Key="mw_restore">Restore</s:String>
    <s:String x:Key="mw_source_code">Source code</s:String>
    <s:String x:Key="mw_made_by">Made with ❤️ by k1tbyte</s:String>
    <s:String x:Key="mw_star_hint">Put a star if you found this helpful ;)</s:String>
    <s:String x:Key="mw_copy_logs">Copy logs to clipboard</s:String>
    <s:String x:Key="mw_export_logs">Export logs to file</s:String>
    <s:String x:Key="mw_update_badge">New version available</s:String>
    <s:String x:Key="mw_full_auto">⚡ Full Auto</s:String>
    <s:String x:Key="mw_auto_download">⚡ Auto Download &amp; Patch</s:String>
    <s:String x:Key="mw_auto_patch">⚡ 1-Click Auto Patch</s:String>
    <s:String x:Key="mw_auto_repair">⚡ Auto Repair &amp; Reinstall</s:String>
    <s:String x:Key="mw_terminal_clear">Clear</s:String>
    <s:String x:Key="mw_terminal_autoscroll">Auto-Scroll</s:String>
    <s:String x:Key="mw_terminal_live">LIVE</s:String>
    <s:String x:Key="mw_terminal_busy">BUSY</s:String>
    <s:String x:Key="mw_uninstall">Uninstall</s:String>
    <s:String x:Key="mw_uninstall_tooltip">Completely remove Wand / WeMod from this computer</s:String>
    <s:String x:Key="dialog_uninstall_title">Uninstall Wand / WeMod</s:String>
    <s:String x:Key="dialog_uninstall_confirm">Are you sure you want to completely uninstall Wand / WeMod from this computer?&#x0a;&#x0a;This will terminate running processes, remove all files from AppData, delete shortcuts, and clean registry keys.</s:String>
    <s:String x:Key="mw_scam_warning">This is an open source project. If you paid for it, you probably got scammed!</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">Settings</s:String>
    <s:String x:Key="settings_language">Language</s:String>
    <s:String x:Key="settings_check_updates">Check for updates on startup</s:String>
    <s:String x:Key="settings_check_prereleases">Also notify about pre-releases</s:String>
    <s:String x:Key="settings_save">Save</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">Update available</s:String>
    <s:String x:Key="up_warning">Click Auto Update to download and apply the update automatically from GitHub.</s:String>
    <s:String x:Key="up_current_version">Current:</s:String>
    <s:String x:Key="up_latest_version">Latest:</s:String>
    <s:String x:Key="up_release_notes">Release notes</s:String>
    <s:String x:Key="up_show_more">Show full changelog</s:String>
    <s:String x:Key="up_show_less">Show release notes</s:String>
    <s:String x:Key="up_loading_changelog">Loading...</s:String>
    <s:String x:Key="up_changelog_failed">Could not load the full changelog.</s:String>
    <s:String x:Key="up_release_notes_unavailable">No release notes were published.</s:String>
    <s:String x:Key="up_open_release">Open release page</s:String>
    <s:String x:Key="up_auto_update">⚡ Auto Update</s:String>
    <s:String x:Key="up_updating">Updating...</s:String>
    <s:String x:Key="up_downloading_update">Downloading latest update from GitHub...</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">Activate WeMod Pro</s:String>
    <s:String x:Key="pv_devtools">DevTools on F12</s:String>
    <s:String x:Key="pv_disable_updates">Disable updates</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">Enable remote access (beta)</s:String>
    <s:String x:Key="pv_custom_scripts">Custom scripts</s:String>
    <s:String x:Key="pv_add_js_scripts">Add .js</s:String>
    <s:String x:Key="pv_custom_scripts_hint">Selected .js files are packed into Wand and loaded in the renderer.</s:String>
    <s:String x:Key="pv_no_custom_scripts">No scripts selected</s:String>
    <s:String x:Key="pv_start">Start</s:String>
    <s:String x:Key="pv_auto_apply">Auto-apply after updates</s:String>
    <s:String x:Key="pv_popup_title">What are we gonna enhance?</s:String>
    <s:String x:Key="pv_patch_method">Patch method</s:String>
    <s:String x:Key="pv_strategy_static">Static (recommended)</s:String>
    <s:String x:Key="pv_strategy_supervised">Supervised (runtime)</s:String>
    <s:String x:Key="pv_strategy_hint">Static edits Wand on disk, which breaks its digital signature. Supervised patches in memory at every launch - it can trip antivirus and may not work in every setup.</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">WeMod directory found at {0} ({1})</s:String>
    <s:String x:Key="log_already_patched">WeMod already patched. If you want to patch again, please restore the backup first.</s:String>
    <s:String x:Key="log_ready">Ready for patching.</s:String>
    <s:String x:Key="log_install_not_found">WeMod directory not found.</s:String>
    <s:String x:Key="log_no_directory">Cant be done. Please specify the directory first.</s:String>
    <s:String x:Key="log_invalid_directory">The selected folder {0} is not a valid WeMod directory.</s:String>
    <s:String x:Key="log_restore_failed">Failed to restore backup: {0}</s:String>
    <s:String x:Key="log_patch_failed">Failed to patch: {0}</s:String>
    <s:String x:Key="log_copied">Logs copied to clipboard.</s:String>
    <s:String x:Key="log_copy_failed">Failed to copy logs: {0}</s:String>
    <s:String x:Key="log_exported">Logs exported to {0}.</s:String>
    <s:String x:Key="log_export_failed">Failed to export logs: {0}</s:String>
    <s:String x:Key="log_open_link_failed">Could not open {0} in a browser.</s:String>
    <s:String x:Key="dialog_pick_install">Select the WeMod directory</s:String>
    <!--#endregion -->

</ResourceDictionary>
