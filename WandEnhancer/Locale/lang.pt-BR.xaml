    <s:String x:Key="up_popup_title">Atualização disponível</s:String>
    <s:String x:Key="up_warning">Clique em Atualização Automática para baixar e aplicar a atualização do GitHub.</s:String>
    <s:String x:Key="up_current_version">Atual:</s:String>
