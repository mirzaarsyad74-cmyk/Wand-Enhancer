    <s:String x:Key="mw_auto_repair">⚡ Auto-Reparo e Reinstalação</s:String>
    <s:String x:Key="mw_terminal_clear">Limpar</s:String>
    <s:String x:Key="mw_terminal_autoscroll">Rolagem automática</s:String>
    <s:String x:Key="mw_terminal_live">AO VIVO</s:String>
    <s:String x:Key="mw_terminal_busy">OCUPADO</s:String>
    <s:String x:Key="mw_uninstall">Desinstalar</s:String>
    <s:String x:Key="mw_uninstall_tooltip">Remover completamente o Wand / WeMod deste computador</s:String>
    <s:String x:Key="dialog_uninstall_title">Desinstalar Wand / WeMod</s:String>
    <s:String x:Key="dialog_uninstall_confirm">Tem certeza de que deseja desinstalar completamente o Wand / WeMod deste computador?&#x0a;&#x0a;Isso encerrará os processos em execução, removerá todos os arquivos do AppData, excluirá atalhos e limpará as chaves do registro.</s:String>
    <s:String x:Key="mw_open_folder">Abrir pasta de instalação no Explorer</s:String>
    <s:String x:Key="mw_auto_client_wand">Wand (wand.com)</s:String>
    <s:String x:Key="mw_auto_client_wemod">WeMod (wemod.com)</s:String>
    <s:String x:Key="mw_scam_warning">Este é um projeto de código aberto. Se você pagou por ele, provavelmente foi enganado!</s:String>
