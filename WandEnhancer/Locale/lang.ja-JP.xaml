<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">日本語</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">フォルダパス</s:String>
    <s:String x:Key="mw_folder_not_found">フォルダが見つかりません</s:String>
    <s:String x:Key="mw_patch">適用</s:String>
    <s:String x:Key="mw_restore">復元</s:String>
    <s:String x:Key="mw_source_code">ソースコード</s:String>
    <s:String x:Key="mw_made_by">k1tbyte が ❤️ を込めて作成</s:String>
    <s:String x:Key="mw_star_hint">役に立ったらスターをつけてください ;)</s:String>
    <s:String x:Key="mw_copy_logs">ログをクリップボードにコピー</s:String>
    <s:String x:Key="mw_export_logs">ログをファイルにエクスポート</s:String>
    <s:String x:Key="mw_update_badge">新しいバージョンが利用可能</s:String>
    <s:String x:Key="mw_full_auto">⚡ フルオート</s:String>
    <s:String x:Key="mw_auto_download">⚡ 自動ダウンロード＆パッチ</s:String>
    <s:String x:Key="mw_auto_patch">⚡ 1クリック自動パッチ</s:String>
    <s:String x:Key="mw_auto_repair">⚡ 自動修復＆再インストール</s:String>
    <s:String x:Key="mw_terminal_clear">クリア</s:String>
    <s:String x:Key="mw_terminal_autoscroll">自動スクロール</s:String>
    <s:String x:Key="mw_terminal_live">LIVE</s:String>
    <s:String x:Key="mw_terminal_busy">処理中</s:String>
    <s:String x:Key="mw_uninstall">アンインストール</s:String>
    <s:String x:Key="mw_uninstall_tooltip">このPCからWand / WeModを完全に削除します</s:String>
    <s:String x:Key="dialog_uninstall_title">Wand / WeMod のアンインストール</s:String>
    <s:String x:Key="dialog_uninstall_confirm">このPCからWand / WeModを完全にアンインストールしますか？&#x0a;&#x0a;実行中のプロセスを停止し、AppDataの全ファイルを削除し、ショートカットとレジストリを削除します。</s:String>
    <s:String x:Key="mw_open_folder">エクスプローラーでインストールフォルダを開く</s:String>
    <s:String x:Key="mw_auto_client_wand">Wand (wand.com)</s:String>
    <s:String x:Key="mw_auto_client_wemod">WeMod (wemod.com)</s:String>
    <s:String x:Key="mw_scam_warning">これはオープンソースプロジェクトです。もし購入した場合は詐欺の可能性があります！</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">設定</s:String>
    <s:String x:Key="settings_language">言語</s:String>
    <s:String x:Key="settings_preferred_client">ダウンロードクライアント</s:String>
    <s:String x:Key="settings_check_updates">起動時に更新を確認</s:String>
    <s:String x:Key="settings_check_prereleases">プレリリース版も通知</s:String>
    <s:String x:Key="settings_save">保存</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">アップデートがあります</s:String>
    <s:String x:Key="up_warning">自動更新をクリックすると、GitHubから自動的に最新版をダウンロードして適用します。</s:String>
    <s:String x:Key="up_current_version">現在：</s:String>
    <s:String x:Key="up_latest_version">最新：</s:String>
    <s:String x:Key="up_release_notes">リリースノート</s:String>
    <s:String x:Key="up_show_more">変更履歴をすべて表示</s:String>
    <s:String x:Key="up_show_less">リリースノートを表示</s:String>
    <s:String x:Key="up_loading_changelog">読み込み中...</s:String>
    <s:String x:Key="up_changelog_failed">変更履歴を読み込めませんでした。</s:String>
    <s:String x:Key="up_release_notes_unavailable">リリースノートはありません。</s:String>
    <s:String x:Key="up_open_release">リリースページを開く</s:String>
    <s:String x:Key="up_auto_update">⚡ 自動更新</s:String>
    <s:String x:Key="up_updating">更新中...</s:String>
    <s:String x:Key="up_downloading_update">GitHubから最新版をダウンロード中...</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">WeMod Pro を有効化</s:String>
    <s:String x:Key="pv_allow_batch_launchers">.bat/.cmd ゲームランチャーのサポート</s:String>
    <s:String x:Key="pv_devtools">F12でDevTools</s:String>
    <s:String x:Key="pv_disable_updates">アップデートを無効化</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">リモートアクセスを有効化（ベータ）</s:String>
    <s:String x:Key="pv_custom_scripts">カスタムスクリプト</s:String>
    <s:String x:Key="pv_add_js_scripts">.js を追加</s:String>
    <s:String x:Key="pv_custom_scripts_hint">選択した .js ファイルは Wand に組み込まれ、レンダラーで読み込まれます。</s:String>
    <s:String x:Key="pv_no_custom_scripts">スクリプトが選択されていません</s:String>
    <s:String x:Key="pv_start">開始</s:String>
    <s:String x:Key="pv_auto_apply">更新後に自動適用</s:String>
    <s:String x:Key="pv_patch_method">パッチ方式</s:String>
    <s:String x:Key="pv_strategy_static">Static (推奨)</s:String>
    <s:String x:Key="pv_strategy_supervised">Supervised</s:String>
    <s:String x:Key="pv_strategy_hint">Static はディスク上の Wand を書き換えるため、デジタル署名が壊れます。Supervised は起動のたびにメモリ上でパッチを適用します - ウイルス対策ソフトが反応することがあり、環境によっては動作しない場合があります。</s:String>
    <s:String x:Key="pv_popup_title">何を改善しますか？</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">WeModディレクトリが {0} ({1}) に見つかりました</s:String>
    <s:String x:Key="log_already_patched">WeModは既にパッチが適用されています。もう一度パッチを適用する場合は、まずバックアップを復元してください。</s:String>
    <s:String x:Key="log_ready">パッチ適用の準備ができました。</s:String>
    <s:String x:Key="log_install_not_found">WeModディレクトリが見つかりません。</s:String>
    <s:String x:Key="log_no_directory">実行できません。先にディレクトリを指定してください。</s:String>
    <s:String x:Key="log_invalid_directory">選択したフォルダ {0} は有効なWeModディレクトリではありません。</s:String>
    <s:String x:Key="log_restore_failed">バックアップの復元に失敗しました: {0}</s:String>
    <s:String x:Key="log_patch_failed">パッチの適用に失敗しました: {0}</s:String>
    <s:String x:Key="log_copied">ログをクリップボードにコピーしました。</s:String>
    <s:String x:Key="log_copy_failed">ログのコピーに失敗しました: {0}</s:String>
    <s:String x:Key="log_exported">ログを {0} にエクスポートしました。</s:String>
    <s:String x:Key="log_export_failed">ログのエクスポートに失敗しました: {0}</s:String>
    <s:String x:Key="log_open_link_failed">{0} をブラウザで開くことができませんでした。</s:String>
    <s:String x:Key="dialog_pick_install">WeModディレクトリを選択してください</s:String>
    <!--#endregion -->

</ResourceDictionary>
