<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">Русский</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">Путь к папке</s:String>
    <s:String x:Key="mw_folder_not_found">Папка не найдена</s:String>
    <s:String x:Key="mw_patch">Применить</s:String>
    <s:String x:Key="mw_restore">Восстановить</s:String>
    <s:String x:Key="mw_source_code">Исходный код</s:String>
    <s:String x:Key="mw_made_by">Сделано с ❤️ by k1tbyte</s:String>
    <s:String x:Key="mw_star_hint">Поставьте звезду, если это было полезно ;)</s:String>
    <s:String x:Key="mw_copy_logs">Скопировать логи в буфер обмена</s:String>
    <s:String x:Key="mw_export_logs">Экспортировать логи в файл</s:String>
    <s:String x:Key="mw_update_badge">Доступна новая версия</s:String>
    <s:String x:Key="mw_full_auto">⚡ Полный Авто</s:String>
    <s:String x:Key="mw_auto_download">⚡ Авто-Загрузка и Патч</s:String>
    <s:String x:Key="mw_auto_patch">⚡ Авто-Патч в 1 клик</s:String>
    <s:String x:Key="mw_auto_repair">⚡ Авто-Восстановление и Переустановка</s:String>
    <s:String x:Key="mw_terminal_clear">Очистить</s:String>
    <s:String x:Key="mw_terminal_autoscroll">Автопрокрутка</s:String>
    <s:String x:Key="mw_terminal_live">LIVE</s:String>
    <s:String x:Key="mw_terminal_busy">ЗАНЯТО</s:String>
    <s:String x:Key="mw_uninstall">Удалить</s:String>
    <s:String x:Key="mw_uninstall_tooltip">Полностью удалить Wand / WeMod с этого компьютера</s:String>
    <s:String x:Key="dialog_uninstall_title">Удаление Wand / WeMod</s:String>
    <s:String x:Key="dialog_uninstall_confirm">Вы уверены, что хотите полностью удалить Wand / WeMod с этого компьютера?&#x0a;&#x0a;Это завершит запущенные процессы, удалит все файлы из AppData, удалит ярлыки и очистит ключи реестра.</s:String>
    <s:String x:Key="mw_open_folder">Открыть папку установки в Проводнике</s:String>
    <s:String x:Key="mw_auto_client_wand">Wand (wand.com)</s:String>
    <s:String x:Key="mw_auto_client_wemod">WeMod (wemod.com)</s:String>
    <s:String x:Key="mw_scam_warning">Это проект с открытым исходным кодом. Если вы заплатили за него, вас, скорее всего, обманули!</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">Настройки</s:String>
    <s:String x:Key="settings_language">Язык</s:String>
    <s:String x:Key="settings_preferred_client">Клиент загрузки</s:String>
    <s:String x:Key="settings_check_updates">Проверять обновления при запуске</s:String>
    <s:String x:Key="settings_check_prereleases">Также уведомлять о предварительных версиях</s:String>
    <s:String x:Key="settings_save">Сохранить</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">Доступно обновление</s:String>
    <s:String x:Key="up_warning">Нажмите Авто-Обновление, чтобы автоматически скачать и установить обновление с GitHub.</s:String>
    <s:String x:Key="up_current_version">Текущая:</s:String>
    <s:String x:Key="up_latest_version">Последняя:</s:String>
    <s:String x:Key="up_release_notes">Примечания к выпуску</s:String>
    <s:String x:Key="up_show_more">Показать полный список изменений</s:String>
    <s:String x:Key="up_show_less">Показать примечания к выпуску</s:String>
    <s:String x:Key="up_loading_changelog">Загрузка...</s:String>
    <s:String x:Key="up_changelog_failed">Не удалось загрузить полный список изменений.</s:String>
    <s:String x:Key="up_release_notes_unavailable">Примечания к выпуску не опубликованы.</s:String>
    <s:String x:Key="up_open_release">Открыть страницу выпуска</s:String>
    <s:String x:Key="up_auto_update">⚡ Авто-Обновление</s:String>
    <s:String x:Key="up_updating">Обновление...</s:String>
    <s:String x:Key="up_downloading_update">Загрузка последнего обновления с GitHub...</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">Активировать WeMod Pro</s:String>
    <s:String x:Key="pv_allow_batch_launchers">Поддержка .bat/.cmd лаунчеров игр</s:String>
    <s:String x:Key="pv_devtools">DevTools на F12</s:String>
    <s:String x:Key="pv_disable_updates">Отключить обновления</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">Remote-доступ (beta)</s:String>
    <s:String x:Key="pv_custom_scripts">Свои скрипты</s:String>
    <s:String x:Key="pv_add_js_scripts">Добавить .js</s:String>
    <s:String x:Key="pv_custom_scripts_hint">Выбранные .js попадут в Wand и загрузятся в renderer.</s:String>
    <s:String x:Key="pv_no_custom_scripts">Скрипты не выбраны</s:String>
    <s:String x:Key="pv_start">Начать</s:String>
    <s:String x:Key="pv_auto_apply">Авто-патч после обновлений</s:String>
    <s:String x:Key="pv_popup_title">Что будем улучшать?</s:String>
    <s:String x:Key="pv_patch_method">Метод патча</s:String>
    <s:String x:Key="pv_strategy_static">Static (рекомендуется)</s:String>
    <s:String x:Key="pv_strategy_supervised">Supervised</s:String>
    <s:String x:Key="pv_strategy_hint">Static правит файлы Wand на диске и ломает цифровую подпись. Supervised патчит в памяти при каждом запуске - может срабатывать антивирус и работает не у всех.</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">Директория WeMod найдена в {0} ({1})</s:String>
    <s:String x:Key="log_already_patched">WeMod уже пропатчен. Если вы хотите пропатчить снова, сначала восстановите резервную копию.</s:String>
    <s:String x:Key="log_ready">Готово к патчингу.</s:String>
    <s:String x:Key="log_install_not_found">Директория WeMod не найдена.</s:String>
    <s:String x:Key="log_no_directory">Невозможно выполнить. Пожалуйста, сначала укажите директорию.</s:String>
    <s:String x:Key="log_invalid_directory">Выбранная папка {0} не является допустимой директорией WeMod.</s:String>
    <s:String x:Key="log_restore_failed">Не удалось восстановить резервную копию: {0}</s:String>
    <s:String x:Key="log_patch_failed">Не удалось пропатчить: {0}</s:String>
    <s:String x:Key="log_copied">Логи скопированы в буфер обмена.</s:String>
    <s:String x:Key="log_copy_failed">Не удалось скопировать логи: {0}</s:String>
    <s:String x:Key="log_exported">Логи экспортированы в {0}.</s:String>
    <s:String x:Key="log_export_failed">Не удалось экспортировать логи: {0}</s:String>
    <s:String x:Key="log_open_link_failed">Не удалось открыть {0} в браузере.</s:String>
    <s:String x:Key="dialog_pick_install">Выберите директорию WeMod</s:String>
    <!--#endregion -->

</ResourceDictionary>
