<Window x:Class="WandEnhancer.View.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WandEnhancer.View.MainWindow"
        xmlns:controls="clr-namespace:WandEnhancer.View.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowVm}"
        Title="WandEnhancer"
        Height="570" MaxHeight="570"
        Width="860" MaxWidth="860" 
        Opacity="0.97"
        Background="Transparent"
        WindowStyle="None"
        FontFamily="{StaticResource Inter}"
        AllowsTransparency="True">
    <Border CornerRadius="7" Background="{DynamicResource Background}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90"
                              RenderingBias="Quality" ShadowDepth="2"/>
        </Border.Effect>
                
        <Grid>
            <Grid Background="Transparent" VerticalAlignment="Top"
                  MouseLeftButtonDown="OnDragMove" Height="55">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25 0 0 0">
                    <Viewbox VerticalAlignment="Center" Width="32" Height="32">
                        <Path 
                            Fill="White" Data="{StaticResource Logo}"/>
                    </Viewbox>
                    <TextBlock Foreground="{DynamicResource Foreground}"
                               FontWeight="SemiBold" Opacity="0.9"
                               VerticalAlignment="Center"
                               FontSize="18" Margin="10 0 0 0">
                        <Bold>
                            WandEnhancer 
                        </Bold>
                    </TextBlock>
                    <TextBlock x:Name="VersionLabel" VerticalAlignment="Bottom"
                               Opacity="0.7" FontSize="10" Margin="5 0 0 5"
                               Foreground="{DynamicResource Foreground}">
                        v 1.0.0
                    </TextBlock>

                    <Button Margin="10 0 0 0" Padding="8 2"
                            VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold"
                            Background="{DynamicResource Primary}"
                            Foreground="{DynamicResource PrimaryForeground}"
                            BorderThickness="0" Cursor="Hand"
                            Content="{DynamicResource mw_update_badge}"
                            Command="{Binding ShowUpdateCommand}"
                            ToolTip="{DynamicResource up_popup_title}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <!-- Collapsed by default so offline builds never show the badge. -->
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <CornerRadius x:Key="CornerRadius">4 4 4 4</CornerRadius>
                        </Button.Resources>
                    </Button>

                </StackPanel>
                                
                <StackPanel  HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0 0 5 0"
                        Width="25" Height="25" Padding="5.5"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource CogIcon}"
                        Command="{Binding OpenSettingsCommand}"
                        />
                    <Button
                        Margin="9 0 15 0"
                        Tag="{StaticResource CloseIcon}"
                        Width="25" Height="25" Padding="6.5"
                        HorizontalAlignment="Right"
                        Click="OnClosing"
                        VerticalAlignment="Center">
                        <Button.Resources>
                            <CornerRadius x:Key="CornerRadius">5 5 5 5</CornerRadius>
                        </Button.Resources>
                        <Button.Style>
                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Secondary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Destructive}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border Background="{DynamicResource Border}" Height="1" VerticalAlignment="Bottom"></Border>
                                
            </Grid>
            <Grid Margin="0 55 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="10" Cursor="Hand" Background="Transparent">
                    <TextBox Style="{StaticResource TitledTextBox}"
                             IsReadOnly="True"
                             Text="{Binding WeModInfo.RootDirectory, Mode=OneWay}"
                             VerticalAlignment="Center">
                    </TextBox>
                    <Grid.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding SetFolderPathCommand}" />
                    </Grid.InputBindings>
                </Grid>

                    
                    <!-- MINI TERMINAL FOR LIVE LOGS -->
                    <Border Grid.Row="1" BorderBrush="#1e293b" BorderThickness="1"
                            Margin="10 0 10 10" CornerRadius="6" Background="#090d16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Terminal Top Header Bar -->
                            <Border Grid.Row="0" Background="#0f172a" CornerRadius="5 5 0 0" BorderBrush="#1e293b" BorderThickness="0 0 0 1">
                                <Grid Margin="8 0">
                                    <!-- Left: Terminal Dots & Title -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="#ef4444" Margin="0 0 5 0"/>
                                        <Ellipse Width="9" Height="9" Fill="#f59e0b" Margin="0 0 5 0"/>
                                        <Ellipse Width="9" Height="9" Fill="#10b981" Margin="0 0 8 0"/>
                                        <TextBlock Text="wand-terminal:~$ live logs" Foreground="#94a3b8"
                                                   FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Center: Live Indicator Pulse -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#22c55e" Margin="0 0 5 0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Fill" Value="#f59e0b"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{DynamicResource mw_terminal_live}" Foreground="#22c55e"
                                                   FontFamily="Consolas, monospace" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource mw_terminal_busy}"/>
                                                            <Setter Property="Foreground" Value="#f59e0b"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Right: Terminal Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Padding="6 2" Margin="0 0 6 0" FontSize="10" FontFamily="Consolas, monospace"
                                                Command="{Binding ToggleAutoScrollCommand}"
                                                ToolTip="{DynamicResource mw_terminal_autoscroll}"
                                                Content="{DynamicResource mw_terminal_autoscroll}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#64748b"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTerminalAutoScroll}" Value="True">
                                                            <Setter Property="Foreground" Value="#38bdf8"/>
                                                            <Setter Property="BorderBrush" Value="#0284c7"/>
                                                            <Setter Property="Background" Value="#0c283d"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Width="22" Height="22" Padding="4" Margin="0 0 4 0"
                                                Style="{StaticResource IconButton}"
                                                Tag="{StaticResource ClearIcon}"
                                                ToolTip="{DynamicResource mw_terminal_clear}"
                                                Command="{Binding ClearLogsCommand}"/>
                                        <Button Width="22" Height="22" Padding="4" Margin="0 0 4 0"
                                                Style="{StaticResource IconButton}"
                                                Tag="{StaticResource CopyIcon}"
                                                ToolTip="{DynamicResource mw_copy_logs}"
                                                Command="{Binding CopyLogsCommand}"/>
                                        <Button Width="22" Height="22" Padding="4"
                                                Style="{StaticResource IconButton}"
                                                Tag="{StaticResource ExportIcon}"
                                                ToolTip="{DynamicResource mw_export_logs}"
                                                Command="{Binding ExportLogsCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Terminal Log Stream -->
                            <Grid Grid.Row="1" Background="#06090e">
                                <ListBox ItemsSource="{Binding LogList}" SelectionMode="Single"
                                         BorderBrush="Transparent" BorderThickness="0"
                                         Background="Transparent" 
                                         x:Name="LogList"
                                         Padding="6 8"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Margin" Value="0 0 0 3"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <StackPanel Orientation="Horizontal" Margin="0 1">
                                                            <!-- Timestamp -->
                                                            <TextBlock Text="{Binding TimeFormatted, StringFormat='[{0}]'}"
                                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                                       FontSize="11" Foreground="#475569" Margin="0 0 6 0"
                                                                       VerticalAlignment="Top"/>
                                                            <!-- Tag Badge -->
                                                            <Border Background="{Binding TagBackground}" BorderBrush="{Binding TagColor}"
                                                                    BorderThickness="1" CornerRadius="3" Padding="4 1" Margin="0 0 7 0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Tag}" FontSize="9.5" FontWeight="Bold"
                                                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                                                           Foreground="{Binding TagColor}"/>
                                                            </Border>
                                                            <!-- Message -->
                                                            <TextBox Text="{Binding CleanMessage}"
                                                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                                                     FontSize="11.5" Foreground="#e2e8f0"
                                                                     Background="Transparent" TextWrapping="Wrap"
                                                                     BorderThickness="0" IsReadOnly="True"
                                                                     Cursor="IBeam" Padding="0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                <!-- Bottom Action Controls -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Margin="10 0 10 10">
                    <!-- Restore Button (if backup exists) -->
                    <Button Margin="0 0 8 0" Padding="12 0" Height="36"
                            Command="{Binding RestoreBackupCommand}"
                            FontWeight="SemiBold" FontSize="12.5"
                            Style="{StaticResource {x:Type Button}}"
                            IsEnabled="{Binding IsIdle}"
                            Visibility="{Binding CanRestore, Converter={StaticResource ToVisibilityConverter}}"
                            Content="{DynamicResource mw_restore}"/>

                    <!-- Auto Repair Button -->
                    <Button Margin="0 0 8 0" Padding="12 0" Height="36"
                            Command="{Binding AutoRepairCommand}"
                            FontWeight="SemiBold" FontSize="12.5"
                            Style="{StaticResource {x:Type Button}}"
                            IsEnabled="{Binding IsIdle}"
                            Content="{DynamicResource mw_auto_repair}"/>

                    <!-- Manual Options Popup -->
                    <Button Margin="0 0 8 0" Padding="12 0" Height="36"
                            Command="{Binding ApplyPatchCommand}"
                            FontWeight="SemiBold" FontSize="12.5"
                            Style="{StaticResource {x:Type Button}}"
                            IsEnabled="{Binding IsPatchEnabled}"
                            Content="{DynamicResource mw_patch}"/>

                    <!-- Prominent ⚡ Full Auto Button -->
                    <Button Height="36" Padding="18 0" MinWidth="190"
                            Style="{StaticResource ColoredButton}"
                            IsEnabled="{Binding IsIdle}"
                            FontWeight="Bold" FontSize="13.5"
                            Command="{Binding FullAutoCommand}"
                            Content="{Binding AutoButtonText}"/>
                </StackPanel>

                <!-- Left Footer Info & Scam Warning Badge -->
                <DockPanel Grid.Row="2" Margin="10 0 10 10" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                                Cursor="Hand" 
                                HorizontalAlignment="Left"
                                MouseDown="OpenSourceClicked" 
                                Background="Transparent">
                        <Viewbox VerticalAlignment="Center" Width="28" Height="28">
                            <Path Fill="White" Data="{StaticResource GitHub}"/>
                        </Viewbox>
                        <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                            <TextBlock FontSize="10">
                                <Hyperlink Foreground="{DynamicResource AccentForeground}"><Run Text="{DynamicResource mw_source_code}"/></Hyperlink>
                                <Run Text=" • " Foreground="{DynamicResource MutedForeground}"/>
                                <Run Foreground="{DynamicResource AccentForeground}" Text="{DynamicResource mw_made_by}"/>
                                <Run Text=" • " Foreground="{DynamicResource MutedForeground}"/>
                                <Run Foreground="{DynamicResource MutedForeground}" Text="{DynamicResource mw_star_hint}"/>
                            </TextBlock>
                            <!-- Prominent Anti-Scam Open Source Warning Badge -->
                            <Border Margin="0 4 0 0" Background="#261214" BorderBrush="#7f1d1d" BorderThickness="1" CornerRadius="3" Padding="6 2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠ " Foreground="#f87171" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource mw_scam_warning}" Foreground="#fca5a5" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
            
            <controls:PopupHost x:Name="PopupHost"/>
        </Grid>
    </Border>
</Window>
